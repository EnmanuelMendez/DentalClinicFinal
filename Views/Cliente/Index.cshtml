@model IEnumerable<DentalClinic.Models.Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="container-fluid mt-4">
    <h1>Clientes</h1>
    <p class="text-muted">Edita la información directamente en la tabla</p>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No hay clientes registrados.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th>Teléfono</th>
                        <th>Reservas</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>
                                <input type="text" class="form-control form-control-sm cliente-nombre"
                                       data-id="@c.Id" value="@c.Nombre" />
                            </td>

                            <td>
                                <input type="email" class="form-control form-control-sm cliente-email"
                                       data-id="@c.Id" value="@c.Email" />
                            </td>

                            <td>
                                <input type="text" class="form-control form-control-sm cliente-telefono"
                                       data-id="@c.Id" value="@c.Telefono" />
                            </td>

                            <td>
                                <span class="badge bg-primary">@((c.Reservas?.Count) ?? 0)</span>
                            </td>

                            <td>
                                <button class="btn btn-success btn-sm btn-guardar" data-id="@c.Id">Guardar</button>
                                <a href="/Cliente/Delete/@c.Id" class="btn btn-danger btn-sm ms-2">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-guardar').forEach(btn => {
            btn.addEventListener('click', async () => {

                const id = btn.dataset.id;

                const nombre = document.querySelector(`.cliente-nombre[data-id="${id}"]`).value;
                const email = document.querySelector(`.cliente-email[data-id="${id}"]`).value;
                const telefono = document.querySelector(`.cliente-telefono[data-id="${id}"]`).value;

                const body = new URLSearchParams({ id, nombre, email, telefono });

                const res = await fetch('/Cliente/EditarCliente', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body
                });

                alert(res.ok ? 'Cliente actualizado' : 'Error al actualizar');
            });
        });
    </script>
}
