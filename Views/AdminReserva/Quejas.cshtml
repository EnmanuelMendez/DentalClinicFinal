@model IEnumerable<DentalClinic.Models.Queja>

@{
    ViewData["Title"] = "Quejas";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>⚠️ Quejas de Clientes</h1>
        </div>
        <div class="col-md-4 text-end">
            <a href="/Admin/Dashboard" class="btn btn-secondary">← Volver al Dashboard</a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-success" role="alert">
            ✅ No hay quejas registradas. ¡Excelente servicio!
        </div>
    }
    else
    {
        @foreach (var queja in Model)
        {
            <div class="card mb-3 border-danger">
                <div class="card-header bg-danger text-white">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <h5 class="mb-0">
                                @queja.Reserva?.Cliente?.Nombre
                                <span class="badge bg-warning ms-2">
                                    @queja.Reserva?.Servicio?.Nombre
                                </span>
                            </h5>
                        </div>
                        <div class="col-md-6 text-end">
                            <small>@queja.Fecha.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <p class="mb-0">@queja.Descripcion</p>
                </div>
            </div>
        }
    }
</div>
