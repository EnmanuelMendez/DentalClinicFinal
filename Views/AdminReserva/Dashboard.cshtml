@{
    ViewData["Title"] = "Dashboard Administrativo";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1>📊 Dashboard Administrativo</h1>
            <p class="text-muted">Bienvenido al panel de control de Dental Clinic</p>
        </div>
    </div>

    <!-- KPIs Principales -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h6 class="card-title text-muted">Total Reservas</h6>
                    <h3 class="text-primary">@ViewBag.TotalReservas</h3>
                    <small class="text-muted">
                        <span class="badge bg-warning">@ViewBag.ReservasPendientes Pendiente</span>
                        <span class="badge bg-success">@ViewBag.ReservasConfirmadas Confirmada</span>
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h6 class="card-title text-muted">Total Clientes</h6>
                    <h3 class="text-success">@ViewBag.TotalClientes</h3>
                    <small class="text-muted">@ViewBag.ClientesAnonimos Anónimos</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h6 class="card-title text-muted">Servicios</h6>
                    <h3 class="text-info">@ViewBag.TotalServicios</h3>
                    <small class="text-muted">Disponibles</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h6 class="card-title text-muted">Valoración Promedio</h6>
                    <h3 class="text-warning">@ViewBag.PromedioValoraciones.ToString("F1") ⭐</h3>
                    <small class="text-muted">@ViewBag.TotalValoraciones valoraciones</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Estadísticas Detalladas -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">📋 Estado de Reservas</h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-4">
                            <h4 class="text-warning">@ViewBag.ReservasPendientes</h4>
                            <small>Pendiente</small>
                        </div>
                        <div class="col-md-4">
                            <h4 class="text-success">@ViewBag.ReservasConfirmadas</h4>
                            <small>Confirmada</small>
                        </div>
                        <div class="col-md-4">
                            <h4 class="text-info">@ViewBag.ReservasFinalizado</h4>
                            <small>Finalizado</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">📝 Feedback</h5>
                </div>
                <div class="card-body">
                    <p>
                        <strong>Valoraciones:</strong> @ViewBag.TotalValoraciones
                        <a href="/Admin/Valoraciones" class="btn btn-sm btn-primary ms-2">Ver todas</a>
                    </p>
                    <p>
                        <strong>Quejas:</strong> @ViewBag.TotalQuejas
                        <a href="/Admin/Quejas" class="btn btn-sm btn-danger ms-2">Ver todas</a>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Accesos Rápidos -->
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">🔧 Gestión</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <a href="/Reserva/Index" class="btn btn-primary w-100">📅 Gestionar Reservas</a>
