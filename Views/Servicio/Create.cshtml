@model DentalClinic.Models.Servicio
@{
    ViewData["Title"] = "Crear Servicio";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">➕ Nuevo Servicio</h5>
                </div>

                <div class="card-body">

                    <form asp-action="Create" method="post">

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-control" required />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descripcion" class="form-label"></label>
                            <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="DuracionMinutos" class="form-label"></label>
                                <input asp-for="DuracionMinutos" type="number" class="form-control" />
                                <span asp-validation-for="DuracionMinutos" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="MargenErrorMinutos" class="form-label"></label>
                                <input asp-for="MargenErrorMinutos" type="number" class="form-control" />
                                <span asp-validation-for="MargenErrorMinutos" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="CostoBase" class="form-label"></label>
                                <input asp-for="CostoBase" type="number" step="0.01" class="form-control" required />
                                <span asp-validation-for="CostoBase" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="Activo" class="form-check-input" />
                            <label asp-for="Activo" class="form-check-label"></label>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-lg">Guardar</button>
                            <a asp-action="Index" class="btn btn-secondary mt-2">Volver</a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
