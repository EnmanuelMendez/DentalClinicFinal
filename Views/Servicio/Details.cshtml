@model DentalClinic.Models.Servicio
@{
    ViewData["Title"] = "Detalle del Servicio";
}

<div class="container mt-4">

    <h2>🏥 Detalle del Servicio</h2>

    <dl class="row mt-3">
        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Nombre</dd>

        <dt class="col-sm-3">Descripción</dt>
        <dd class="col-sm-9">@Model.Descripcion</dd>

        <dt class="col-sm-3">Duración</dt>
        <dd class="col-sm-9">@Model.DuracionMinutos minutos</dd>

        <dt class="col-sm-3">Margen de Error</dt>
        <dd class="col-sm-9">@Model.MargenErrorMinutos minutos</dd>

        <dt class="col-sm-3">Activo</dt>
        <dd class="col-sm-9">@((Model.Activo) ? "Sí" : "No")</dd>

        <dt class="col-sm-3">Costo Base</dt>
        <dd class="col-sm-9">$@Model.CostoBase.ToString("F2")</dd>
    </dl>

    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary ms-2">Volver</a>
</div>
